FROM registry.ci.openshift.org/ocp/builder:rhel-9-golang-1.26-openshift-5.0 AS builder
WORKDIR /go/src/github.com/openshift/csi-operator
COPY . .
RUN make GO_BUILD_PACKAGES=./cmd/volume-create

FROM registry.ci.openshift.org/ocp/5.0:base-rhel9
COPY --from=builder /go/src/github.com/openshift/csi-operator/bin/volume-create /usr/bin/
COPY test/e2e/aws-efs/* /usr/share/aws-efs-csi-driver/
COPY test/e2e/aws-s3files/* /usr/share/aws-s3files-csi-driver/

ENTRYPOINT ["/usr/bin/volume-create"]
LABEL io.k8s.display-name="OpenShift AWS Volume Creator" \
	io.k8s.description="Creates AWS EFS and S3 Files test infrastructure for CSI testing."
