FROM registry.ci.openshift.org/ocp/builder:rhel-9-golang-1.26-openshift-5.0 AS builder
WORKDIR /go/src/github.com/openshift/csi-operator
COPY . .
RUN make GO_BUILD_PACKAGES=./cmd/create-s3files-volume

FROM registry.ci.openshift.org/ocp/5.0:base-rhel9
COPY --from=builder /go/src/github.com/openshift/csi-operator/bin/create-s3files-volume /usr/bin/
COPY test/e2e/aws-s3files/* /usr/share/aws-s3files-csi-driver/

ENTRYPOINT ["/usr/bin/create-s3files-volume"]
LABEL io.k8s.display-name="OpenShift AWS S3 Files Creator" \
	io.k8s.description="Creates and removes AWS S3 Files infrastructure for CSI testing."
