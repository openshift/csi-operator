#!/bin/bash

# Build bundle and index images of aws-efs-csi-driver-operator for given
# driver + operator images. The output is available in opm-bundle directory.

set -o errexit
set -o nounset
set -o pipefail

if [ "$#" -ne "4" ]; then
    echo "Usage: $0 <input_driver_image> <input_operator_image> <output_bundle_image> <output_index_image>"
    exit 1
fi

exec "$(dirname "$0")/create-bundle" \
    aws-efs \
    aws-efs-csi-driver-operator \
    aws-efs \
    quay.io/openshift/origin-aws-efs-csi-driver:latest \
    "$@"
